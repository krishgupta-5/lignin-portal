# ============================================
# Lignin Portal Backend Configuration
# ============================================

# --- 1. LOCAL MONGODB (Default) ---
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_URL=mongodb://127.0.0.1:27017

# --- 2. CLOUD MONGODB (MongoDB Atlas) ---
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database Name
DATABASE_NAME=lignin_predictor

# JWT Secret & Expiration (30 days = 43200 mins)
SECRET_KEY=lignin-predictor-dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Email / SMTP Configuration (for real OTP verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM_NAME=Lignin Yield Predictor

